# =============================================================================
# SDR Brain Python — Variables de Entorno (OpenRouter & Google Calendar)
# =============================================================================

# API Key de OpenRouter (con guardrail training-restricted: no usar modelos :free)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Modelo principal en OpenRouter
OPENROUTER_MODEL=google/gemini-2.5-flash

# Cadena de modelos de respaldo separados por coma (openrouter/auto siempre queda al final)
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku,openrouter/auto

# Credenciales OAuth 2.0 para renovación automática de tokens de Google Calendar
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
